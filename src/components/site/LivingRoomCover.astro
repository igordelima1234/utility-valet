---
/*
 * Cover art for "The Utility Valet Living Room" video.
 * One 1920×1080 SVG so it scales crisply and can be exported as a YouTube thumbnail.
 * The owner sits inside the house-shaped frame used in the homepage hero.
 */
interface Props {
	class?: string;
}
const { class: className } = Astro.props;

// House silhouette (rounded roof peak and eaves); bottom runs off-canvas.
const HOUSE = "M1000 1200 L1000 560 Q1000 520 1030 494 L1368 196 Q1400 168 1432 196 L1770 494 Q1800 520 1800 560 L1800 1200 Z";
---

<svg viewBox="0 0 1920 1080" class={className} role="img" aria-label="The Utility Valet Living Room" preserveAspectRatio="xMidYMid slice">
	<defs>
		<linearGradient id="lr-sky" x1="0" y1="0" x2="1" y2="0.35">
			<stop offset="0" stop-color="#c3e4f9"></stop>
			<stop offset="0.32" stop-color="#86d4f6"></stop>
			<stop offset="0.58" stop-color="#2cc3f0"></stop>
			<stop offset="0.8" stop-color="#1a9fe0"></stop>
			<stop offset="1" stop-color="#184f9c"></stop>
		</linearGradient>
		<radialGradient id="lr-glow" cx="0.5" cy="0.5" r="0.5">
			<stop offset="0" stop-color="#fff" stop-opacity="0.55"></stop>
			<stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
		</radialGradient>
		<linearGradient id="lr-logo" x1="0" y1="0" x2="1" y2="0.2">
			<stop offset="0" stop-color="#cd3ef9"></stop>
			<stop offset="1" stop-color="#0e6cf7"></stop>
		</linearGradient>
		<!-- Fades the leftover wall lettering on the photo's left side into navy -->
		<linearGradient id="lr-shade" x1="0" y1="0" x2="1" y2="0">
			<stop offset="0" stop-color="#07091c" stop-opacity="1"></stop>
			<stop offset="0.36" stop-color="#07091c" stop-opacity="0.98"></stop>
			<stop offset="0.47" stop-color="#07091c" stop-opacity="0.55"></stop>
			<stop offset="0.6" stop-color="#07091c" stop-opacity="0"></stop>
		</linearGradient>
		<linearGradient id="lr-floor" x1="0" y1="0" x2="0" y2="1">
			<stop offset="0.55" stop-color="#050a4a" stop-opacity="0"></stop>
			<stop offset="1" stop-color="#050a4a" stop-opacity="0.75"></stop>
		</linearGradient>
		<radialGradient id="lr-rim" cx="0.5" cy="0.5" r="0.5">
			<stop offset="0" stop-color="#2cccfb" stop-opacity="0.32"></stop>
			<stop offset="1" stop-color="#2cccfb" stop-opacity="0"></stop>
		</radialGradient>
		<clipPath id="lr-house"><path d={HOUSE}></path></clipPath>
		<filter id="lr-grain" x="0" y="0" width="100%" height="100%">
			<feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="3" stitchTiles="stitch"></feTurbulence>
			<feColorMatrix type="saturate" values="0"></feColorMatrix>
			<feComponentTransfer><feFuncA type="linear" slope="0.14"></feFuncA></feComponentTransfer>
			<feComposite in2="SourceGraphic" operator="in"></feComposite>
		</filter>
		<filter id="lr-shadow" x="-20%" y="-20%" width="140%" height="140%">
			<feDropShadow dx="0" dy="30" stdDeviation="40" flood-color="#050a4a" flood-opacity="0.35"></feDropShadow>
		</filter>
	</defs>

	<!-- Background -->
	<rect width="1920" height="1080" fill="url(#lr-sky)"></rect>
	<circle cx="1400" cy="560" r="760" fill="url(#lr-glow)"></circle>
	<g fill="none" stroke="#fff" stroke-opacity="0.18" stroke-width="2">
		<circle cx="1400" cy="640" r="560"></circle>
		<circle cx="1400" cy="640" r="700"></circle>
	</g>

	<!-- House frame: outer translucent band, photo, white band -->
	<path d={HOUSE} fill="none" stroke="#fff" stroke-opacity="0.35" stroke-width="110" stroke-linejoin="round"></path>
	<g filter="url(#lr-shadow)">
		<path d={HOUSE} fill="#07091c"></path>
	</g>
	<g clip-path="url(#lr-house)">
		<circle cx="1790" cy="330" r="380" fill="url(#lr-rim)"></circle>
		<image style="mix-blend-mode:lighten" href="/brand/photos/owner-living-room.jpg" x="886" y="200" width="1051" height="1035" preserveAspectRatio="xMidYMid slice"></image>
		<rect x="1000" y="160" width="800" height="1040" fill="url(#lr-shade)"></rect>
		<rect x="1000" y="160" width="800" height="1040" fill="url(#lr-floor)"></rect>
	</g>
	<path d={HOUSE} fill="none" stroke="#fff" stroke-width="34" stroke-linejoin="round"></path>

	<!-- Copy -->
	<image href="/brand/logo/utility-valet-logo.png" x="120" y="96" width="248" height="90"></image>

	<g transform="translate(120 404)">
		<rect width="310" height="64" rx="32" fill="#fff" fill-opacity="0.6"></rect>
		<circle cx="34" cy="32" r="16" fill="#050a4a"></circle>
		<path d="M29 23.5 L42 32 L29 40.5 Z" fill="#2cccfb"></path>
		<text x="66" y="42" font-family="'Unbounded Variable', Unbounded, sans-serif" font-size="24" font-weight="500" letter-spacing="3" fill="#050a4a">WATCH NOW</text>
	</g>

	<text font-family="'Unbounded Variable', Unbounded, sans-serif" font-weight="500" fill="#050a4a">
		<tspan x="116" y="560" font-size="56" fill-opacity="0.8" letter-spacing="-1">The Utility Valet</tspan>
		<tspan x="110" y="720" font-size="156" letter-spacing="-6">Living</tspan>
		<tspan x="110" y="880" font-size="156" letter-spacing="-6" fill="url(#lr-logo)">Room</tspan>
	</text>
	<text x="120" y="972" font-family="'DM Sans Variable', 'DM Sans', sans-serif" font-size="38" font-weight="500" fill="#050a4a" fill-opacity="0.75">Turning on every American home</text>

	<!-- Play badge where the frame meets the copy -->
	<g class="lr-play" transform="translate(1000 820)">
		<circle r="112" fill="#fff" fill-opacity="0.35"></circle>
		<circle r="84" fill="#2cccfb"></circle>
		<path d="M-22 -34 L38 0 L-22 34 Z" fill="#050a4a" stroke="#050a4a" stroke-width="10" stroke-linejoin="round"></path>
	</g>

	<rect width="1920" height="1080" filter="url(#lr-grain)" style="mix-blend-mode:overlay"></rect>
</svg>

<style>
	.lr-play {
		transform-box: fill-box;
		transform-origin: center;
		transition: scale 0.4s cubic-bezier(0.22, 1, 0.36, 1);
	}
	:global(.group:hover) .lr-play,
	:global(.group:focus-within) .lr-play {
		scale: 1.08;
	}
</style>
