---
import LivingRoomCover from "@/components/site/LivingRoomCover.astro";
import { ResidentsVisual, RevenueVisual, TimeVisual } from "@/components/site/WhyPartnerVisuals";

// `at` places the glass panel over the calm part of each photo (panel centre, % of card).
const benefits = [
	{
		photo: "partner-revenue",
		visual: "revenue",
		at: "left:70%;top:44%",
		title: "Earn extra through revenue sharing",
		body: "Partnering with Utility Valet simplifies utility and service connections while creating a hassle-free revenue stream for your property, enhancing both efficiency and resident experience.",
	},
	{
		photo: "partner-staff",
		visual: "time",
		at: "left:31%;top:46%",
		title: "Save time and effort for your staff",
		body: "Eliminate the hassle of utility setups. Utility Valet handles it all, freeing your staff to focus on higher-priority tasks and boosting operational efficiency.",
	},
	{
		photo: "partner-residents",
		visual: "residents",
		at: "left:24%;top:46%",
		title: "Make life easier for your residents",
		body: "With over 1,700 resident reviews, we take pride in making move-ins stress-free. Our dedicated service ensures residents feel supported from day one, leading to happier residents and lower turnover rates.",
	},
];

const YOUTUBE_ID = "uMPjCjfpBFU";
---

<section class="py-20 md:py-28">
	<div class="mx-auto max-w-site px-5 lg:px-8">
		<div class="max-w-2xl">
			<p class="mb-3 font-heading text-xs font-medium tracking-widest text-royal uppercase">For property managers</p>
			<h2 class="mb-0">Why partner with us?</h2>
		</div>

		<div class="mt-12 grid gap-12 md:mt-16 lg:grid-cols-3 lg:gap-6 xl:gap-8">
			{
				benefits.map((b) => (
					<article class="md:grid md:grid-cols-[1.15fr_1fr] md:items-center md:gap-8 lg:block">
						<div class="@container relative aspect-[4/3] overflow-hidden rounded-3xl bg-mist">
							<img
								src={`/brand/photos/${b.photo}-1200.jpg`}
								alt=""
								class="absolute inset-0 size-full object-cover"
								width="1200"
								height="896"
								loading="lazy"
							/>
							<div class="pointer-events-none absolute -translate-1/2 select-none" style={b.at} aria-hidden="true">
								<div class="scale-[0.58] @xs:scale-[0.66] @sm:scale-[0.76] @md:scale-[0.86] @lg:scale-[0.95]">
									{b.visual === "revenue" && <RevenueVisual client:visible />}
									{b.visual === "time" && <TimeVisual client:visible />}
									{b.visual === "residents" && <ResidentsVisual client:visible />}
								</div>
							</div>
						</div>
						<div>
							<h3 class="mt-6 mb-2 text-xl! md:mt-0 md:text-[1.375rem]! lg:mt-6">{b.title}</h3>
							<p class="text-muted-foreground">{b.body}</p>
						</div>
					</article>
				))
			}
		</div>

		<!-- Living Room video: poster first, YouTube loads only on play -->
		<div data-video-facade class="group relative mt-16 aspect-video overflow-hidden rounded-3xl bg-gradient-sky md:mt-20">
			<LivingRoomCover class="absolute inset-0 size-full" />
			<button
				type="button"
				data-youtube-id={YOUTUBE_ID}
				class="absolute inset-0 rounded-3xl focus-visible:ring-4 focus-visible:ring-royal focus-visible:ring-inset focus-visible:outline-none"
				aria-label="Play video: The Utility Valet Living Room"
			>
			</button>
		</div>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLButtonElement>("[data-youtube-id]").forEach((button) => {
		button.addEventListener("click", () => {
			const facade = button.closest<HTMLElement>("[data-video-facade]");
			if (!facade) return;
			const iframe = document.createElement("iframe");
			iframe.src = `https://www.youtube-nocookie.com/embed/${button.dataset.youtubeId}?autoplay=1&rel=0`;
			iframe.title = "The Utility Valet Living Room";
			iframe.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
			iframe.allowFullscreen = true;
			iframe.className = "absolute inset-0 size-full";
			facade.replaceChildren(iframe);
			iframe.focus();
		});
	});
</script>
