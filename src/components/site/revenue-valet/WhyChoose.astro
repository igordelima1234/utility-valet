---
import { BadgeDollarSign, Headset, Layers } from "lucide-react";
import { Button } from "@/components/ui/button";
import { pillars } from "@/data/revenue-valet";

const icons = [Layers, BadgeDollarSign, Headset];
const tints = ["bg-ice-strong", "bg-ice", "bg-[#ebe9ff]"];
---

<section id="why" class="py-20 md:py-28">
	<div class="mx-auto grid max-w-site gap-14 px-5 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20 lg:px-8">
		<div class="lg:sticky lg:top-32 lg:self-start">
			<p class="mb-3 font-heading text-xs font-medium tracking-widest text-royal uppercase">Why Revenue Valet</p>
			<h2 class="mb-0">Why choose Utility Valet's Revenue Valet?</h2>

			<figure class="grain relative isolate mt-10 overflow-hidden rounded-3xl bg-gradient-deep p-8 text-white md:p-10">
				<img src="/brand/icons/quote.svg" alt="" class="h-6 w-auto brightness-0 invert" />
				<blockquote class="mt-5 font-heading text-xl leading-snug md:text-2xl">
					Since we’re not the big fish, <span class="text-cyan">we push harder.</span>
				</blockquote>
				<figcaption class="mt-6 text-sm text-white/70">The Utility Valet service model</figcaption>
			</figure>

			<Button client:visible href="#demo" icon="arrow" size="lg" className="mt-8 max-sm:w-full max-sm:justify-between">
				Get a demo
			</Button>
		</div>

		<ol class="grid">
			{
				pillars.map((p, i) => {
					const Icon = icons[i];
					return (
						<li class="grid gap-6 border-t border-navy/10 py-10 first:border-t-0 first:pt-0 sm:grid-cols-[auto_1fr] sm:gap-8 lg:py-12">
							<div class="flex items-center gap-5 sm:flex-col sm:items-start">
								<span class={`flex size-16 items-center justify-center rounded-2xl text-royal ${tints[i]}`}>
									<Icon className="size-8" strokeWidth={1.6} />
								</span>
								<span class="font-heading text-sm font-medium text-steel tabular-nums">0{i + 1}</span>
							</div>
							<div>
								<h3 class="mb-3 text-2xl! md:text-[2rem]!">{p.title}</h3>
								<p class="max-w-xl text-lg text-muted-foreground">{p.body}</p>
							</div>
						</li>
					);
				})
			}
		</ol>
	</div>
</section>
