---
interface Props {
	id: string;
	eyebrow: string;
	title: string;
	description?: string;
}

const { id, eyebrow, title, description } = Astro.props;
---

<section id={id} class="scroll-mt-24 border-t border-border py-16 md:py-20">
	<p class="mb-2 font-heading text-xs font-medium tracking-widest text-royal uppercase">{eyebrow}</p>
	<h2 class="mb-3">{title}</h2>
	{description && <p class="mb-10 max-w-2xl text-muted-foreground">{description}</p>}
	<slot />
</section>
