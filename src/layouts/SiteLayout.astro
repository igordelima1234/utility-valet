---
import "@/styles/app.css";
import SiteNav from "@/components/site/SiteNav";
import Footer from "@/components/site/Footer.astro";

interface Props {
	title: string;
	description?: string;
	/** Overrides for the closing CTA banner above the footer, or `false` to hide it. */
	cta?: { title?: string; label?: string; href?: string } | false;
	/** Social sharing image (1200×630), relative to the site root. */
	image?: string;
}

const {
	title,
	description = "Utility Valet connects electricity, water, internet and more before move-in, so residents arrive to a home that's ready.",
	cta,
	image = "/brand/og-cover.jpg",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/png" sizes="32x32" href="/brand/logo/favicon-32.png" />
		<link rel="apple-touch-icon" href="/brand/logo/apple-touch-icon.png" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content="Utility Valet" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Utility Valet: Turning on every American home" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
	</head>
	<body>
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-full focus:bg-navy focus:px-4 focus:py-2 focus:text-white"
			>Skip to content</a
		>
		<SiteNav client:load />
		<main id="main">
			<slot />
		</main>
		<Footer cta={cta !== false} ctaTitle={cta ? cta.title : undefined} ctaLabel={cta ? cta.label : undefined} ctaHref={cta ? cta.href : undefined} />
	</body>
</html>
