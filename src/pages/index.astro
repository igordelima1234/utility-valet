---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Hero from "@/components/site/Hero.astro";
import PartnerMarquee from "@/components/site/PartnerMarquee.astro";
import WhyPartner from "@/components/site/WhyPartner.astro";
import RevenueCalculator from "@/components/site/RevenueCalculator";
import AllInOne from "@/components/site/AllInOne.astro";
import HowItWorks from "@/components/site/HowItWorks";
import Testimonials from "@/components/site/Testimonials";
import Blog from "@/components/site/Blog.astro";
---

<SiteLayout title="Utility Valet · Turning on every American home">
	<Hero />
	<PartnerMarquee />
	<WhyPartner />
	<RevenueCalculator client:visible />
	<div class="h-3 md:h-4"></div>
	<AllInOne />
	<div class="h-3 md:h-4"></div>
	<HowItWorks client:visible />
	<Testimonials client:visible />
	<Blog />
</SiteLayout>
